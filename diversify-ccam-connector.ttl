#    Object Properties
#################################################################

###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#administrates
:administrates rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :inhabits ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( <http://www.semanticweb.org/diversify-ccam/ontologies/policy/DecisionMaker>
                                           <http://www.semanticweb.org/diversify-ccam/ontologies/policy/Planner>
                                         )
                           ] ;
               rdfs:range <https://saref.etsi.org/saref4city/AdministrativeArea> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#alignedWith
:alignedWith rdf:type owl:ObjectProperty ;
             rdfs:domain <http://www.semanticweb.org/diversify-ccam/ontologies/culture/Value> ;
             rdfs:range <http://www.semanticweb.org/mihnea.tufis/ontologies/2025/7/policy/Goal> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#cultureOf
:cultureOf rdf:type owl:ObjectProperty ;
           rdfs:domain <http://www.semanticweb.org/diversify-ccam/ontologies/culture/Culture> ;
           rdfs:range <http://www.semanticweb.org/diversify-ccam/ontologies/geography/HumanPopulation> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#funds
:funds rdf:type owl:ObjectProperty ;
       rdfs:domain <http://www.semanticweb.org/diversify-ccam/ontologies/policy/FinancialResourceAllocation> ;
       rdfs:range [ rdf:type owl:Class ;
                    owl:unionOf ( <http://www.semanticweb.org/diversify-ccam/ontologies/geography/Infrastructure>
                                  <http://www.semanticweb.org/diversify-ccam/ontologies/geography/TransportSystem>
                                )
                  ] .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#hasCoverage
:hasCoverage rdf:type owl:ObjectProperty ;
             rdfs:domain <http://www.semanticweb.org/diversify-ccam/ontologies/geography/TransportSystem> ;
             rdfs:range <https://saref.etsi.org/saref4city/AdministrativeArea> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#inhabits
:inhabits rdf:type owl:ObjectProperty ;
          rdfs:domain <http://www.semanticweb.org/mihnea.tufis/ontologies/2025/7/policy/Stakeholder> ;
          rdfs:range <https://saref.etsi.org/saref4city/AdministrativeArea> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#managedBy
:managedBy rdf:type owl:ObjectProperty ;
           rdfs:domain <http://www.semanticweb.org/diversify-ccam/ontologies/geography/TransportSystem> ;
           rdfs:range <http://www.semanticweb.org/diversify-ccam/ontologies/policy/TransportOperator> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#residesIn
:residesIn rdf:type owl:ObjectProperty ;
           rdfs:subPropertyOf :inhabits ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( <http://www.semanticweb.org/diversify-ccam/ontologies/policy/Community>
                                       <http://www.semanticweb.org/diversify-ccam/ontologies/policy/EndUser>
                                     )
                       ] ;
           rdfs:range <https://saref.etsi.org/saref4city/AdministrativeArea> .


###  http://www.semanticweb.org/diversify-ccam/ontologies/policy/isFinancedBy
<http://www.semanticweb.org/diversify-ccam/ontologies/policy/isFinancedBy> rdfs:domain [ rdf:type owl:Class ;
                                                                                         owl:unionOf ( <http://www.semanticweb.org/diversify-ccam/ontologies/geography/TransportSystem>
                                                                                                       <http://www.semanticweb.org/diversify-ccam/ontologies/policy/NonFinancialTool>
                                                                                                     )
                                                                                       ] ;
                                                                           rdfs:range <http://www.semanticweb.org/diversify-ccam/ontologies/policy/FinancialResourceAllocation> .


