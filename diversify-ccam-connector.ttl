#################################################################

###  http://www.semanticweb.org/diversify-ccam/ontologies/connector#hasSchedule
:hasSchedule rdf:type owl:DatatypeProperty ;
             rdfs:domain <http://www.semanticweb.org/diversify-ccam/ontologies/geography/TransportSystem> ;
             rdfs:range xsd:string .


