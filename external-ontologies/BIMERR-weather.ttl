:AtmosphericPhenomenon a owl:Class;
  rdfs:subClassOf :WeatherProperty;
  rdfs:comment "A natural phenomenon involving the physical properties of matter and energy."@en;
  rdfs:label "Atmospheric Phenomenon"@en .

:Precipitation a owl:Class;
  rdfs:subClassOf :AtmosphericPhenomenon;
  rdfs:comment "Any product of the condensation of atmospheric water vapour that falls under gravity from clouds. The main forms of precipitation include drizzle, rain, sleet, snow, ice pellets, graupel and hail.";
  rdfs:label "Precipitation"@en .

:Season a owl:Class;
  rdfs:label "Season"@en .

:Snow a owl:Class;
  rdfs:subClassOf :Precipitation;
  rdfs:comment "Individual ice crystals that grow while suspended in the atmosphere—usually within clouds—and then fall, accumulating on the ground where they undergo further changes."@en;
  rdfs:label "Snow"@en .

:WeatherProperty a owl:Class;
  rdfs:comment "Property type to classify  weather data."@en;
  rdfs:label "Weather Property"@en .

:Wind a owl:Class;
  rdfs:subClassOf :AtmosphericPhenomenon;
  rdfs:comment "The perceptible natural movement of the air, especially in the form of a current of air blowing from a particular direction." .

