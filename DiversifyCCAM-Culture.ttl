#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/diversify-ccam/Adherence
:Adherence rdf:type owl:Class ;
           rdfs:subClassOf :Attitude ;
           terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000377253}" ;
           rdfs:label "Adherence"@en ;
           skos:definition "The conscious and voluntary commitment to follow, uphold, or respect certain principles, values, norms, or practices, often within a cultural, ethical, or educational framework."@en .


###  http://www.semanticweb.org/diversify-ccam/Attitude
:Attitude rdf:type owl:Class ;
          terms:source "https://unesdoc.unesco.org/ark:/48223/pf0000232993" ;
          rdfs:label "Attitude"@en ;
          skos:definition "Attitudes refer to a set of values and beliefs that individuals hold, which affect how they respond to various issues and interact with others. These include openness to others, respect for diversity, and a sense of common humanity."@en .


###  http://www.semanticweb.org/diversify-ccam/Belief
:Belief rdf:type owl:Class ;
        terms:source "Based on: http://www.purl.org/drammar#Belief"@en ;
        rdfs:label "Belief"@en ;
        skos:definition "A mental attitude of an person or a group toward a proposition, which the person may treat as true (even if it is not), and which the person uses as part of reasoning, planning or behaviour."@en .


###  http://www.semanticweb.org/diversify-ccam/Bureaucracy
:Bureaucracy rdf:type owl:Class ;
             rdfs:subClassOf :GovernanceCulture ;
             rdfs:label "Bureaucracy"@en .


###  http://www.semanticweb.org/diversify-ccam/CulturalEntity
:CulturalEntity rdf:type owl:Class ;
                terms:source "Based on: https://www.mdpi.com/2571-9408/1/2/26"@en ;
                rdfs:label "Cultural Entity"@en ;
                skos:definition "An item of cultural heritage—tangible or intangible—that is recognised for its historical, social or cultural value and whose documentation, management or conservation can be described."@en .


###  http://www.semanticweb.org/diversify-ccam/Culture
:Culture rdf:type owl:Class ;
         terms:source "https://unesdoc.unesco.org/ark:/48223/pf0000184755" ;
         rdfs:label "Culture"@en ;
         skos:definition "Culture should be regarded as the set of distinctive spiritual, material, intellectual and emotional features of society or a social group... it encompasses, in addition to art and literature, lifestyles, ways of living together, value systems, traditions and beliefs."@en .


###  http://www.semanticweb.org/diversify-ccam/Federalism
:Federalism rdf:type owl:Class ;
            rdfs:subClassOf :GovernanceCulture ;
            rdfs:label "Federalism"@en .


###  http://www.semanticweb.org/diversify-ccam/GovernanceCulture
:GovernanceCulture rdf:type owl:Class ;
                   rdfs:subClassOf :Culture ;
                   rdfs:label "Governance Culture"@en .


###  http://www.semanticweb.org/diversify-ccam/Identity
:Identity rdf:type owl:Class ;
          rdfs:subClassOf :Attitude ;
          terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000159252}"@en ;
          rdfs:label "Identity"@en ;
          skos:definition "The set of characteristics, values, affiliations, and experiences that define an individual or group, often shaped by culture, history, language, and social context."@en .


###  http://www.semanticweb.org/diversify-ccam/Language
:Language rdf:type owl:Class ;
          rdfs:label "Language"@en ;
          skos:definition "A structured system of communication using symbols (spoken, written or signed) and conventions shared by a community or agent, enabling expression, interpretation and exchange of information."@en .


###  http://www.semanticweb.org/diversify-ccam/Law
:Law rdf:type owl:Class ;
     rdfs:subClassOf :Norm ;
     terms:source "Based on: https://voegelinview.com/legal-ontology-does-the-law-exist/"@en ;
     rdfs:label "Law"@en ;
     skos:definition "A system of rules or norms, constituted by authority and reason, that governs, regulates, and binds the behavior of individuals and entities within a community to promote order and the common good."@en .


###  http://www.semanticweb.org/diversify-ccam/Leadership
:Leadership rdf:type owl:Class ;
            rdfs:subClassOf :GovernanceCulture ;
            rdfs:label "Leadership"@en .


###  http://www.semanticweb.org/diversify-ccam/Norm
:Norm rdf:type owl:Class ;
      terms:source "Based on: https://bp4mc2.org/def/skos-lex?utm_source=chatgpt.com"@en ;
      rdfs:label "Norm"@en ;
      skos:definition "A rule or standard that influences or constrains an action (an Act)"@en .


###  http://www.semanticweb.org/diversify-ccam/PlanningCulture
:PlanningCulture rdf:type owl:Class ;
                 rdfs:subClassOf :GovernanceCulture ;
                 rdfs:label "Planning Culture"@en .


###  http://www.semanticweb.org/diversify-ccam/Satisfaction
:Satisfaction rdf:type owl:Class ;
              rdfs:subClassOf :Attitude ;
              terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000367416}" ;
              rdfs:label "Satisfaction"@en ;
              skos:definition "The perceived degree to which personal or collective expectations related to cultural engagement, education, or life quality are met.e"@en .


###  http://www.semanticweb.org/diversify-ccam/Symbol
:Symbol rdf:type owl:Class ;
        terms:source "Based on: https://br0ast.github.io/ICON/ICONOntologyDocumentationcurrent/index-en.html#Symbol"@en ;
        rdfs:label "Symbol"@en ;
        skos:definition "An entity that represents or stands for another entity, concept, or relation within a shared conceptualization, enabling communication and reasoning over knowledge expressed in an ontology."@en .


###  http://www.semanticweb.org/diversify-ccam/Trust
:Trust rdf:type owl:Class ;
       rdfs:subClassOf :Attitude ;
       terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000377253}" ;
       rdfs:label "Trust"@en ;
       skos:definition "The degree to which individuals or communities perceive institutions as legitimate, transparent, accountable, and serving the public good."@en .


###  http://www.semanticweb.org/diversify-ccam/Value
:Value rdf:type owl:Class ;
       terms:source "Based on: https://sigma.ontologyportal.org:8443/sigma/WordNet.jsp?word=value&POS=1"@en ;
       rdfs:label "Value"@en ;
       skos:definition "A property or characteristic that something has which can be assessed or measured to indicate desirability, worth, or importance."@en .


