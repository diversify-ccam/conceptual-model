@prefix : <http://www.semanticweb.org/diversify-ccam/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix schema: <http://schema.org/> .
@base <http://www.semanticweb.org/diversify-ccam/> .

<http://www.semanticweb.org/diversify-ccam> rdf:type owl:Ontology ;
                                             owl:imports <http://www.opengis.net/ont/geosparql/1.1> ,
                                                         <https://bimerr.iot.linkeddata.es/def/weather> ;
                                             rdfs:comment "This is version v0.1 of the DiversifyCCAM comceptual model." .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/decription
dc:decription rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
terms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
terms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
terms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
terms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
terms:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://schema.org/domainIncludes
schema:domainIncludes rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/diversify-ccam/attituteTowards
:attituteTowards rdf:type owl:ObjectProperty ;
                 rdfs:domain :Attitude ;
                 rdfs:range :CulturalThing .


###  http://www.semanticweb.org/diversify-ccam/bridgesOver
:bridgesOver rdf:type owl:ObjectProperty ;
             rdfs:domain :Bridge ;
             rdfs:range :WaterBody .


###  http://www.semanticweb.org/diversify-ccam/canBeBoth
:canBeBoth rdf:type owl:ObjectProperty ;
           rdfs:domain :Innovation ;
           rdfs:range :NewTechnologies ,
                      :Sustainability .


###  http://www.semanticweb.org/diversify-ccam/consistsOf
:consistsOf rdf:type owl:ObjectProperty ;
            rdfs:domain :Perception ;
            rdfs:range :Benefits ,
                       :Risks .


###  http://www.semanticweb.org/diversify-ccam/existsIn
:existsIn rdf:type owl:ObjectProperty ;
          rdfs:domain :BuiltEnvironment ;
          rdfs:range :NaturalEnvironment .


###  http://www.semanticweb.org/diversify-ccam/hasAttitude
:hasAttitude rdf:type owl:ObjectProperty .


###  http://www.semanticweb.org/diversify-ccam/hasClimate
:hasClimate rdf:type owl:ObjectProperty ;
            rdfs:domain :NaturalEnvironment ;
            rdfs:range :Climate .


###  http://www.semanticweb.org/diversify-ccam/hasEcosystem
:hasEcosystem rdf:type owl:ObjectProperty ;
              rdfs:domain :NaturalEnvironment ;
              rdfs:range :Ecosystem .


###  http://www.semanticweb.org/diversify-ccam/hasFauna
:hasFauna rdf:type owl:ObjectProperty ;
          rdfs:domain :Ecosystem .


###  http://www.semanticweb.org/diversify-ccam/hasFlora
:hasFlora rdf:type owl:ObjectProperty ;
          rdfs:domain :Ecosystem .


###  http://www.semanticweb.org/diversify-ccam/hasInfrastructure
:hasInfrastructure rdf:type owl:ObjectProperty ;
                   rdfs:domain :Settlement ;
                   rdfs:range :Infrastructure .


###  http://www.semanticweb.org/diversify-ccam/hasMorphology
:hasMorphology rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain <http://www.opengis.net/ont/geosparql#Feature> ,
                           :BuiltEnvironment ;
               rdfs:range :Morphology .


###  http://www.semanticweb.org/diversify-ccam/hasPopulation
:hasPopulation rdf:type owl:ObjectProperty ;
               rdfs:domain :Settlement .


###  http://www.semanticweb.org/diversify-ccam/hasTopography
:hasTopography rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain <http://www.opengis.net/ont/geosparql#Feature> ,
                           :NaturalEnvironment ;
               rdfs:range :Topography .


###  http://www.semanticweb.org/diversify-ccam/influences
:influences rdf:type owl:ObjectProperty ;
            rdfs:domain :Benefits ,
                        :Risks ;
            rdfs:range :PerceivedMeasurement .


###  http://www.semanticweb.org/diversify-ccam/isDrivenBy
:isDrivenBy rdf:type owl:ObjectProperty ;
            rdfs:domain :Trust ;
            rdfs:range :Driver .


###  http://www.semanticweb.org/diversify-ccam/isMeasuredBy
:isMeasuredBy rdf:type owl:ObjectProperty ;
              rdfs:domain :Driver ,
                          :Perception ;
              rdfs:range :PerceivedMeasurement .


###  http://www.semanticweb.org/diversify-ccam/motivatedBy
:motivatedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :Attitude ;
             rdfs:range :Perception .


###  http://www.semanticweb.org/diversify-ccam/sharesInfrastructure
:sharesInfrastructure rdf:type owl:ObjectProperty ;
                      rdfs:domain :TransportInfrastructure ;
                      rdfs:range :TransportInfrastructure .


###  http://www.semanticweb.org/diversify-ccam/tunnelsThrough
:tunnelsThrough rdf:type owl:ObjectProperty ;
                rdfs:domain :Tunnel ;
                rdfs:range :Landform .


###  http://www.semanticweb.org/diversify-ccam/usesInfrastructure
:usesInfrastructure rdf:type owl:ObjectProperty .


#################################################################
#    Classes
#################################################################

###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ;
                                               rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ;
                                               rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ,
                                                                <http://www.opengis.net/spec/geosparql/1.0/req/core/feature-class> ,
                                                                <http://www.opengis.net/spec/geosparql/1.1/req/core/feature-class> ;
                                               skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.1> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.2> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.3> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.5> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.6> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.7> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.8> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.9> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.2> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.3> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3> ,
                                                            <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4> ;
                                               skos:note "A Feature represents a uniquely identifiable phenomenon, for example a river or an apple. While such phenomena (and therefore the Features used to represent them) are bounded, their boundaries may be crisp (e.g., the declared boundaries of a state), vague (e.g., the delineation of a valley versus its neighboring mountains), and change with time (e.g., a storm front). While discrete in nature, Features may be created from continuous observations, such as an isochrone that determines the region that can be reached by ambulance within 5 minutes."@en .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#SpatialObject> ;
                                                rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ,
                                                                 <http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-class> ,
                                                                 <http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-class> ;
                                                skos:definition "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en ;
                                                skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.2> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.3> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.4> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.5> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.6> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.2.8> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.1> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.2> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.3.3> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.2> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.3> ,
                                                             <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.2.4> ;
                                                skos:note "Geometry can be used as a representation of the shape, extent or location of a Feature and may exist as a self-contained entity."@en ;
                                                skos:prefLabel "Geometry"@en .


###  http://www.opengis.net/ont/geosparql#SpatialObject
<http://www.opengis.net/ont/geosparql#SpatialObject> rdf:type owl:Class ;
                                                     rdfs:subClassOf :Geography ;
                                                     rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql#> ,
                                                                      <http://www.opengis.net/spec/geosparql/1.0/req/core/spatial-object-class> ,
                                                                      <http://www.opengis.net/spec/geosparql/1.1/req/core/spatial-object-class> ;
                                                     skos:definition "Anything spatial (being or having a shape, position or an extent)."@en ;
                                                     skos:example <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.1.1> ,
                                                                  <http://www.opengis.net/spec/geosparql/1.1/specification.html#C.1.1.1.2> ;
                                                     skos:note "Subclasses of this class are expected to be used for instance data."@en ;
                                                     skos:prefLabel "Spatial Object"@en .


###  http://www.semanticweb.org/diversify-ccam/Accountability
:Accountability rdf:type owl:Class ;
                rdfs:subClassOf :Driver ;
                terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000231940}" ;
                rdfs:label "Accountability"@en ;
                skos:definition "The obligation of individuals, organizations, and institutions to explain and justify their actions, accept responsibility, and disclose results in a transparent manner."@en .


###  http://www.semanticweb.org/diversify-ccam/Adherence
:Adherence rdf:type owl:Class ;
           rdfs:subClassOf :Attitude ;
           terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000377253}" ;
           rdfs:label "Adherence"@en ;
           skos:definition "The conscious and voluntary commitment to follow, uphold, or respect certain principles, values, norms, or practices, often within a cultural, ethical, or educational framework."@en .


###  http://www.semanticweb.org/diversify-ccam/Attitude
:Attitude rdf:type owl:Class ;
          rdfs:subClassOf :Culture ;
          terms:source "https://unesdoc.unesco.org/ark:/48223/pf0000232993" ;
          rdfs:label "Attitude"@en ;
          skos:definition "Attitudes refer to a set of values and beliefs that individuals hold, which affect how they respond to various issues and interact with others. These include openness to others, respect for diversity, and a sense of common humanity."@en .


###  http://www.semanticweb.org/diversify-ccam/Benefits
:Benefits rdf:type owl:Class ;
          rdfs:subClassOf :Culture ;
          terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000375704}" ;
          rdfs:label "Benefits"@en ;
          skos:definition "Tangible or intangible rewards that individuals or groups receive through access to opportunities, resources, or services in areas such as culture, education, or innovation."@en .


###  http://www.semanticweb.org/diversify-ccam/Bridge
:Bridge rdf:type owl:Class ;
        rdfs:subClassOf :RoadInfrastructure ;
        terms:source "https://dictionary.cambridge.org/us/dictionary/english/bridge" ;
        rdfs:label "Bridge"@en ;
        skos:definition "A structure that is built over a river, road, or railroad to allow people and vehicles to cross from one side to the other."@en .


###  http://www.semanticweb.org/diversify-ccam/BuiltEnvironment
:BuiltEnvironment rdf:type owl:Class ;
                  rdfs:subClassOf :Environment ;
                  owl:disjointWith :NaturalEnvironment ;
                  terms:source "https://www.epa.gov/smm/basic-information-about-built-environment" ;
                  rdfs:label "Built Environment"@en ;
                  skos:definition "Man-made or modified structures that provide people with living, working, and recreational spaces."@en .


###  http://www.semanticweb.org/diversify-ccam/Climate
:Climate rdf:type owl:Class ;
         rdfs:subClassOf :Geography ;
         rdfs:label "Climate"@en ;
         skos:definition "The prevailing weather conditions in an area over a long period of time."@en .


###  http://www.semanticweb.org/diversify-ccam/CulturalThing
:CulturalThing rdf:type owl:Class ;
               rdfs:subClassOf :Culture ;
               terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000370514}" ;
               rdfs:label "Cultural Thing"@en ;
               skos:definition "Any concept that embodies, expresses, or represents the cultural identity, heritage, or creativity of a community."@en .


###  http://www.semanticweb.org/diversify-ccam/Culture
:Culture rdf:type owl:Class ;
         terms:source "https://unesdoc.unesco.org/ark:/48223/pf0000184755" ;
         rdfs:label "Culture"@en ;
         skos:definition "Culture should be regarded as the set of distinctive spiritual, material, intellectual and emotional features of society or a social group... it encompasses, in addition to art and literature, lifestyles, ways of living together, value systems, traditions and beliefs."@en .


###  http://www.semanticweb.org/diversify-ccam/Cycling
:Cycling rdf:type owl:Class ;
         rdfs:subClassOf :Mobility ;
         terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000380649}" ;
         rdfs:label "Cycling"@en ;
         skos:definition "The use of bicycles as a mode of transportation, recreation, or physical activity, often promoted in urban planning for its role in reducing emissions, enhancing public health, and supporting inclusive access."@en .


###  http://www.semanticweb.org/diversify-ccam/CyclingInfrastructure
:CyclingInfrastructure rdf:type owl:Class ;
                       rdfs:subClassOf :TransportInfrastructure ;
                       rdfs:comment "Existence of safe, connected cycling infrastructure is paramount to induce cycling as the fear of mixed traffic is the main deterrent from cycling. Increased demand for cycling and sustainable transport also calls for providing such infrastructure."@en ;
                       rdfs:label "Cycling Infrastructure"@en ;
                       skos:definition "Infrastructure designed for safe and efficient movement of cyclists and parking bicycles."@en .


###  http://www.semanticweb.org/diversify-ccam/DigitalInfrastructure
:DigitalInfrastructure rdf:type owl:Class ;
                       rdfs:subClassOf :Infrastructure ;
                       terms:source "https://neosnetworks.com/resources/blog/what-is-digital-infrastructure/" ;
                       rdfs:label "Digital Infrastructure"@en ;
                       skos:definition "Digital infrastructure is the physical hardware and software-based technologies that enable digital services. It includes the IT systems and networks that enable organisations to operate and communicate."@en .


###  http://www.semanticweb.org/diversify-ccam/Driver
:Driver rdf:type owl:Class ;
        rdfs:subClassOf :Culture ;
        terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000374267}" ;
        rdfs:label "Driver"@en ;
        skos:definition "An underlying cause or force that contributes to individual or collective motivation, policy direction, or systemic transformation toward specific goals."@en .


###  http://www.semanticweb.org/diversify-ccam/EVChargingStation
:EVChargingStation rdf:type owl:Class ;
                   rdfs:subClassOf :DigitalInfrastructure ;
                   terms:source "https://www.sciencedirect.com/topics/engineering/ev-charging-station" ;
                   rdfs:label "EV Charging Station"@en ;
                   skos:definition "An electric vehicle (EV) charging station, also referred as electric vehicle supply equipment (EVSE), supplies electric power to recharge the batteries in plug-in electric vehicles (PEVs) and other EVs."@en .


###  http://www.semanticweb.org/diversify-ccam/Ecosystem
:Ecosystem rdf:type owl:Class ;
           rdfs:subClassOf :Geography ;
           rdfs:label "Ecosystem"@en ;
           skos:definition "The complex of a community of organisms and its environment functioning as an ecological unit."@en .


###  http://www.semanticweb.org/diversify-ccam/Effectiveness
:Effectiveness rdf:type owl:Class ;
               rdfs:subClassOf :Driver ;
               terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000231940}" ;
               rdfs:label "Effectiveness"@en ;
               skos:definition "A measure to the extent to which education systems or governance mechanisms fulfill their goals and contribute to equitable and quality outcomes."@en .


###  http://www.semanticweb.org/diversify-ccam/Environment
:Environment rdf:type owl:Class ;
             rdfs:subClassOf :Geography ;
             terms:source """Based on: https://sor.epa.gov/sor_internet/registry/termreg/searchandretrieve/termsandacronyms/search.do?checkedAcronym=true&checkedTerm=true&hasDefinitions=false&matchCriteria=Exact&search=&term=environment

and
             https://www.unep.org/about-un-environment/policies-and-strategies/un-environment-strategy-environmental-education-and""" ;
             rdfs:label "Environment"@en ;
             skos:definition "The surroundings in which an organism or organization operates, including air, water, land, natural resources, flora, fauna, humans, and their interrelations."@en .


###  http://www.semanticweb.org/diversify-ccam/Fairness
:Fairness rdf:type owl:Class ;
          rdfs:subClassOf :Driver ;
          terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000374016}" ;
          rdfs:label "Fairness"@en ;
          skos:definition "The quality of making judgments that are free from discrimination, bias, or favoritism, ensuring equitable access, opportunity, and representation for all individuals and groups."@en .


###  http://www.semanticweb.org/diversify-ccam/Fog
:Fog rdf:type owl:Class ;
     rdfs:subClassOf :Precipitation ;
     terms:source "https://cloudatlas.wmo.int/en/fog.html" ;
     rdfs:label "Fog"@en ;
     skos:definition "A suspension of very small, usually microscopic water droplets in the air, reducing visibility at the Earth's surface."@en .


###  http://www.semanticweb.org/diversify-ccam/Geography
:Geography rdf:type owl:Class ;
           rdfs:label "Geography"@en ;
           skos:definition "The physical position of an area and its influence on access to transportation systems and infrastructure. It considers factors such as proximity to major roads, railways and public transit networks."@en .


###  http://www.semanticweb.org/diversify-ccam/GreenInitiatives
:GreenInitiatives rdf:type owl:Class ;
                  rdfs:subClassOf :Sustainability ;
                  terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000380649}" ;
                  rdfs:label "Green Initiatives"@en ;
                  skos:definition "Programs, projects, or actions aimed at promoting environmental sustainability, to advance ecological protection, climate action, and sustainable development."@en .


###  http://www.semanticweb.org/diversify-ccam/Hill
:Hill rdf:type owl:Class ;
      rdfs:subClassOf :Landform ;
      terms:source "http://purl.obolibrary.org/obo/ENVO_00000083" ;
      rdfs:label "Hill"@en ;
      skos:definition "A rounded elevation of limited extent rising above the surrounding land with local relief of less than 300m."@en .


###  http://www.semanticweb.org/diversify-ccam/Identity
:Identity rdf:type owl:Class ;
          rdfs:subClassOf :Attitude ;
          terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000159252}"@en ;
          rdfs:label "Identity"@en ;
          skos:definition "The set of characteristics, values, affiliations, and experiences that define an individual or group, often shaped by culture, history, language, and social context."@en .


###  http://www.semanticweb.org/diversify-ccam/Inclusivity
:Inclusivity rdf:type owl:Class ;
             rdfs:subClassOf :Driver ;
             terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000374016}" ;
             rdfs:label "Inclusivity"@en ;
             skos:definition "A value and approach that ensures equal access, respect for diversity, and full participation for all people, regardless of gender, ethnicity, ability, age, or background."@en .


###  http://www.semanticweb.org/diversify-ccam/Infrastructure
:Infrastructure rdf:type owl:Class ;
                rdfs:subClassOf :BuiltEnvironment ;
                rdfs:label "Infrastructure"@en ;
                skos:definition "Facilities and systems that support the functioning of society. Infrastructure, including transport infrastructure, requires proper planning as well as systematic construction, maintenance and repair of the various elements in order to fulfil its functions. "@en .


###  http://www.semanticweb.org/diversify-ccam/Innovation
:Innovation rdf:type owl:Class ;
            rdfs:subClassOf :CulturalThing ;
            terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000379904}" ;
            rdfs:label "Innovation"@en ;
            skos:definition "The introduction and application of new or significantly improved ideas, products, services, or processes that enhance sustainability, inclusion, or development outcomes."@en .


###  http://www.semanticweb.org/diversify-ccam/Integrity
:Integrity rdf:type owl:Class ;
           rdfs:subClassOf :Driver ;
           terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000371589}" ;
           rdfs:label "Integrity"@en ;
           skos:definition "A moral and ethical quality characterized by honesty, consistency, and adherence to principles, especially in professional, institutional, and public contexts."@en .


###  http://www.semanticweb.org/diversify-ccam/Intermodality
:Intermodality rdf:type owl:Class ;
               rdfs:subClassOf :Mobility ;
               terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000380649}" ;
               rdfs:label "Intermodality"@en ;
               skos:definition "A transport strategy that integrates different mobility modes into a connected network, enabling users to switch between them easily and promoting sustainable, inclusive urban mobility."@en .


###  http://www.semanticweb.org/diversify-ccam/Intersection
:Intersection rdf:type owl:Class ;
              rdfs:subClassOf :RoadInfrastructure ;
              terms:source "https://trt.trb.org/term/92905" ;
              rdfs:label "Intersection"@en ;
              skos:definition "Areas where two or more highways join or cross, within which are included the roadway and roadside facilities for traffic movements in that area."@en .


###  http://www.semanticweb.org/diversify-ccam/LandUseDevelopment
:LandUseDevelopment rdf:type owl:Class ;
                    rdfs:subClassOf :Morphology ;
                    rdfs:label "Land Use Development"@en ;
                    skos:definition "The state of the development in a specific site, both ongoing and completed. "@en .


###  http://www.semanticweb.org/diversify-ccam/Landform
:Landform rdf:type owl:Class ;
          rdfs:subClassOf :Topography ;
          owl:disjointWith :WaterBody ;
          terms:source "http://purl.obolibrary.org/obo/ENVO_01001886" ;
          rdfs:comment "Landforms may be natural or anthropogenic. This term has often has loose usage when referencing entities which are either subterranean or submerged below water bodies. In some cases, oceans themselves are considered landforms. Here, we have provided subclasses to resolve this ambiguity, but place oceans and other water bodies elsewhere.In later revisions, this hiearchy is likely to be reordered based on the formation processes of the entities within it."@en ;
          rdfs:label "Landform"@en ;
          skos:definition "A solid astronomical body part which has been formed from and is composed primarily of the matter of that astronomical body."@en .


###  http://www.semanticweb.org/diversify-ccam/Mobility
:Mobility rdf:type owl:Class ;
          rdfs:subClassOf :CulturalThing ;
          terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000380649}" ;
          rdfs:label "Mobility"@en ;
          skos:definition "The capacity and means for individuals and communities to access places, opportunities, and services through various modes of transport or communication, with attention to sustainability, equity, and resilience."@en .


###  http://www.semanticweb.org/diversify-ccam/Morphology
:Morphology rdf:type owl:Class ;
            rdfs:subClassOf :Geography ;
            rdfs:label "Morphology"@en ;
            skos:definition "The physical and spatial structure and characteristics (e.g. density, size, location) of human settlements within a specific geographical area/site. It refers to land use in relation to different functions (e.g. residential, commercial, and transport functions)."@en .


###  http://www.semanticweb.org/diversify-ccam/NaturalEnvironment
:NaturalEnvironment rdf:type owl:Class ;
                    rdfs:subClassOf :Environment ;
                    terms:source "https://www.ebi.ac.uk/ols4/ontologies/envo/classes/http%253A%252F%252Fpurl.obolibrary.org%252Fobo%252FENVO_01000951" ;
                    rdfs:comment "In most contexts, 'natural' is defined by the lack of intervention or influence by humans and their activities. On Earth, most environments fall on a scale between completely natural and anthropised."@en ;
                    rdfs:label "Natural Environment"@en ;
                    skos:definition "An environmental system in which minimal to no anthropisation has occurred and non-human agents are the primary determinants of the system's dynamics and composition."@en .


###  http://www.semanticweb.org/diversify-ccam/NewMobilityOptions
:NewMobilityOptions rdf:type owl:Class ;
                    rdfs:subClassOf :Innovation ;
                    terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000380649}" ;
                    rdfs:label "New Mobility Options"@en ;
                    skos:definition "Transport solutions that go beyond traditional private car use, including shared, electric, autonomous, or multimodal options designed to reduce environmental impact and improve urban accessibility."@en .


###  http://www.semanticweb.org/diversify-ccam/NewTechnologies
:NewTechnologies rdf:type owl:Class ;
                 rdfs:subClassOf :Innovation ;
                 terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000379904}" ;
                 rdfs:label "New Technologies"@en ;
                 skos:definition "Innovative tools, systems, or methods—Possibly aiming at helping sustainability objectives—that enable transformative change across sectors such as energy, transport, education, health, and governance."@en .


###  http://www.semanticweb.org/diversify-ccam/PedestrianInfrastructure
:PedestrianInfrastructure rdf:type owl:Class ;
                          rdfs:subClassOf :TransportInfrastructure ;
                          terms:source "https://www.sciencedirect.com/topics/social-sciences/transport-infrastructure" ;
                          rdfs:label "Pedestrian Infrastructure"@en ;
                          skos:definition "Pedestrian infrastructure encompasses the physical elements designed to support safe and convenient walking environments, including sidewalks, crosswalks, pedestrian signals, and traffic calming features."@en .


###  http://www.semanticweb.org/diversify-ccam/PerceivedMeasurement
:PerceivedMeasurement rdf:type owl:Class ;
                      rdfs:subClassOf :Culture ;
                      terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000374016}" ;
                      rdfs:label "Perceived Measurement"@en ;
                      skos:definition "A measurement based on individual or group perceptions, often used to evaluate subjective experiences, attitudes, or expectations in contrast to objective metrics."@en .


###  http://www.semanticweb.org/diversify-ccam/Perception
:Perception rdf:type owl:Class ;
            rdfs:subClassOf :Culture ;
            terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000374016}" ;
            rdfs:label "Perception"@en ;
            skos:definition "A mental representation resulting from the interpretation of sensory inputs or social information, which influences behavior, attitudes, and decisions."@en .


###  http://www.semanticweb.org/diversify-ccam/PolicyRules
:PolicyRules rdf:type owl:Class ;
             rdfs:subClassOf :CulturalThing ;
             terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000380649}" ;
             rdfs:label "Policy Rules"@en ;
             skos:definition "A set of rules or frameworks designed to govern actions and outcomes within public administration, organizations, or communities, supporting sustainable development and inclusive governance."@en .


###  http://www.semanticweb.org/diversify-ccam/Precipitation
:Precipitation rdf:type owl:Class ;
               rdfs:subClassOf :WeatherEvent ;
               owl:disjointWith :Wind ;
               terms:source "Based on: https://gcos.wmo.int/en/essential-climate-variables/precipitation" ;
               rdfs:label "Precipitation"@en ;
               skos:definition "Any form of water—liquid or solid—that falls from the atmosphere to the Earth's surface, including rain, snow, sleet, hail, and drizzle."@en .


###  http://www.semanticweb.org/diversify-ccam/PublicInterest
:PublicInterest rdf:type owl:Class ;
                rdfs:subClassOf :Driver ;
                terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000374016}" ;
                rdfs:label "Public Interest"@en ;
                skos:definition "A principle that guides actions, policies, and decisions toward the welfare, rights, and well-being of the general population. It ensures that all actions and decisions contribute to equity, sustainability, and human rights."@en .


###  http://www.semanticweb.org/diversify-ccam/Rain
:Rain rdf:type owl:Class ;
      rdfs:subClassOf :Precipitation ;
      rdfs:label "Rain"@en ;
      skos:definition "Precipitation of drops of water that falls from a cloud."@en .


###  http://www.semanticweb.org/diversify-ccam/Reliability
:Reliability rdf:type owl:Class ;
             rdfs:subClassOf :Driver ;
             terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000247853}" ;
             rdfs:label "Reliability"@en ;
             skos:definition "A measure of the consistency and dependability of outcomes, services, data, or infrastructure, often used to evaluate performance, quality, and trustworthiness."@en .


###  http://www.semanticweb.org/diversify-ccam/Risks
:Risks rdf:type owl:Class ;
       rdfs:subClassOf :Culture ;
       terms:source "Based on: {https://unesdoc.unesco.org/ark:/48223/pf0000236075}" ;
       rdfs:label "Risks"@en ;
       skos:definition "The potential for adverse effects on people, assets, systems, or the environment due to uncertain events or conditions."@en .


###  http://www.semanticweb.org/diversify-ccam/River
:River rdf:type owl:Class ;
       rdfs:subClassOf :WaterBody ;
       terms:source "http://purl.obolibrary.org/obo/ENVO_00000022" ;
       rdfs:label "River"@en ;
       skos:definition "A stream which, through permanent or seasonal flow processes, moves from elevated land towards lower elevations through a definite channel and empties either into a sea, lake, or another river or ends on land as bed seepage and evapotranspiration exceed water supply."@en .


###  http://www.semanticweb.org/diversify-ccam/RoadInfrastructure
:RoadInfrastructure rdf:type owl:Class ;
                    rdfs:subClassOf :TransportInfrastructure ;
                    rdfs:label "Road Infrustructure"@en ;
